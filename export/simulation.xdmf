<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0">
  <Domain>
    <Grid Name="boundary" GridType="Uniform">
      <Topology TopologyType="Hexahedron" NumberOfElements="1">
        <DataItem Dimensions="1 8" NumberType="Int" Format="XML">
          0 1 2 3 4 5 6 7
        </DataItem>
      </Topology>
      <Geometry GeometryType="XYZ">
        <DataItem Dimensions="8 3" NumberType="Float" Precision="8" Format="HDF">simulation.h5:/domain/corners</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="TimeSeries" GridType="Collection" CollectionType="Temporal">
      <Grid Name="step_0000" GridType="Uniform">
        <Time Value="0.0"/>
        <Topology TopologyType="Polyvertex" NumberOfElements="10" NodesPerElement="1"/>
        <Geometry GeometryType="XYZ">
          <DataItem Dimensions="10 3" NumberType="Float" Precision="8" Format="HDF">simulation.h5:/step_0000/positions</DataItem>
        </Geometry>
        <Attribute Name="mass" AttributeType="Scalar" Center="Node">
          <DataItem Dimensions="10" NumberType="Float" Precision="8" Format="HDF">simulation.h5:/step_0000/mass</DataItem>
        </Attribute>
        <Attribute Name="radius" AttributeType="Scalar" Center="Node">
          <DataItem Dimensions="10" NumberType="Float" Precision="8" Format="HDF">simulation.h5:/step_0000/radius</DataItem>
        </Attribute>
        <Attribute Name="velocity" AttributeType="Vector" Center="Node">
          <DataItem Dimensions="10 3" NumberType="Float" Precision="8" Format="HDF">simulation.h5:/step_0000/velocity</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
